<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      底部页签：纯文字，没有图标。

      不用 Material 的 BottomNavigationView，是因为它的条目本来就按「图标 + 文字」排布，
      把图标藏起来只会留出一块空白位、高度也对不上。这里要的就是四个等宽的文字，
      自己用 LinearLayout 排最直接，选中态靠颜色与字重区分。
    -->
    <!-- parent="" 是必须的：名字里带点的话，AAPT 会把「点号前面那一段」当成隐式父样式
         （这里就是 Widget.AudioStream），而它并不存在，构建期会直接报 resource not found。 -->
    <style name="Widget.AudioStream.BottomTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/bottom_tab_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!--
      卡片。全应用一套圆角与留白，布局里不再各写各的。

      边界用「容器色背景 + 一圈细描边」两样一起给，原因是单靠任何一样都不够：
      - 只靠背景色调差：Material 3 的 colorSurface 与容器色在实际屏幕上差别很小，
        用户明确反馈过「看不出每个播放源的边界」；
      - 只靠阴影：深色主题下阴影几乎不可见。
      描边是浅色与深色下都可靠的边界，背景色让它更早被看出来。
      描边色用 colorOutline 而不是 colorOutlineVariant：后者在深色主题下与容器底的差别
      小到几乎看不出来——这是把布局渲染成 PNG 之后当场看出来的，光读代码不会发现。
      （早先这里把 strokeWidth 与 cardElevation 都设成 0，是「为了干净」砍过了头。）
    -->
    <style name="Widget.AudioStream.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHighest</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!--
      卡片里的一行内容。外边距只在竖直方向留，水平一律 0——
      水平方向的缩进由卡片自己的 padding 统一给，行再各自缩进就会参差不齐。
    -->
    <style name="Widget.AudioStream.CardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
    </style>

    <!--
      整宽按钮。inset 全设 0 是必须的：Material 按钮默认自带一圈 inset，
      于是按钮的左边缘会比同卡片里的输入框、下拉框往右缩一截，看起来就是「没对齐」。
    -->
    <style name="Widget.AudioStream.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AudioStream.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AudioStream.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!--
      卡片里那排操作按钮（停止/编辑/删除）。
      inset 全设 0 的理由与整宽按钮一样：Material 按钮自带一圈 inset，
      右对齐之后最右边那个会离卡片右边缘差几个像素，看起来就是「没对齐」。
    -->
    <style name="Widget.AudioStream.RowButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
