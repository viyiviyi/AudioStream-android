<?xml version="1.0" encoding="utf-8"?>
<!--
  播放列表里的一路。

  三个操作平铺成一行文字按钮，没有收进溢出菜单：用户明确要求「能删除、能停止、能修改」，
  收进菜单就等于要他先发现那个菜单。停止与启动共用一个按钮（同一时刻只有一件事可做），
  文本随状态变。

  卡片上没有放缓冲/欠载/丢字节这些计数——它们对用户没有意义，只在日志里留线索。
  出问题时才在状态下面多出一行原因。

  这一路的卡片**自己不带左右外边距**：它的左右由所在的 routeContainer 决定
  （容器已经有 screen_margin 的 padding），这里只留卡片之间的竖直间距。
  多写一层水平边距就是「每行对不齐」的另一半来源。
-->
<com.google.android.material.card.MaterialCardView
            style="@style/Widget.AudioStream.Card" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/routeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/routeState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tiny"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/routeDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tiny"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="音量"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/routeVolumeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/routeVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:value="1.0"
            android:valueFrom="0.0"
            android:valueTo="2.0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tiny"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/routeToggle"
                style="@style/Widget.AudioStream.RowButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="停止" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/routeEdit"
                style="@style/Widget.AudioStream.RowButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="编辑" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/routeDelete"
                style="@style/Widget.AudioStream.RowButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
